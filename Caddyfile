{
    email admin@physrisk.com
}

physrisk.com {
    # Map tiles - higher rate limit
    handle /api/tiles/* {
        rate_limit {remote_host} 600r/m
        uri strip_prefix /api
        reverse_proxy api:8081
    }

    # All other API endpoints - standard rate limit
    handle /api/* {
        rate_limit {remote_host} 60r/m
        uri strip_prefix /api
        reverse_proxy api:8081
    }

    # Swagger UI fetches /openapi.json from the root
    handle /openapi.json {
        reverse_proxy api:8081
    }

    # Route everything else to the UI container
    # On 404, fall back to index.html for SPA client-side routing
    handle {
        reverse_proxy ui:8080 {
            @notfound status 404
            handle_response @notfound {
                rewrite * /index.html
                reverse_proxy ui:8080
            }
        }
    }
}

# Redirect www to non-www (optional, remove if not needed)
www.physrisk.com {
    redir https://physrisk.com{uri} permanent
}
