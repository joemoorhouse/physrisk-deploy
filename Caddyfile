{
    email admin@physrisk.com
}

physrisk.com {
    # Rate limiting zones — defined at site level
    rate_limit {
        # Tiles endpoints: higher limit
        zone tiles {
            match {
                path /api/tiles/*
            }
            key    {remote_host}
            events 600
            window 1m
        }
        # All other API endpoints: standard limit
        # 'not path /api/tiles/*' prevents double-counting tile requests
        zone api {
            match {
                not {
                    path /api/tiles/*
                }
                path /api/*
            }
            key    {remote_host}
            events 60
            window 1m
        }
    }

    # Route API requests to the API container, stripping the /api prefix
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:8081
    }

    # Swagger UI fetches /openapi.json from the root
    handle /openapi.json {
        reverse_proxy api:8081
    }

    # Route everything else to the UI container
    # On 404, fall back to index.html for SPA client-side routing
    handle {
        reverse_proxy ui:8080 {
            @notfound status 404
            handle_response @notfound {
                rewrite * /index.html
                reverse_proxy ui:8080
            }
        }
    }
}

# Redirect www to non-www
www.physrisk.com {
    redir https://physrisk.com{uri} permanent
}
