{
    email admin@physrisk.com
}

physrisk.com {
    # Named matchers — tiles and non-tiles API are mutually exclusive
    @tiles path /api/tiles/*
    @api {
        path /api/*
        not path /api/tiles/*
    }

    rate_limit @tiles {
        zone tiles {
            key    {remote_host}
            events 600
            window 1m
        }
    }

    rate_limit @api {
        zone api {
            key    {remote_host}
            events 60
            window 1m
        }
    }

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:8081
    }

    # Swagger UI fetches /openapi.json from the root
    handle /openapi.json {
        reverse_proxy api:8081
    }

    # Route everything else to the UI container
    # On 404, fall back to index.html for SPA client-side routing
    handle {
        reverse_proxy ui:8080 {
            @notfound status 404
            handle_response @notfound {
                rewrite * /index.html
                reverse_proxy ui:8080
            }
        }
    }
}

# Redirect www to non-www
www.physrisk.com {
    redir https://physrisk.com{uri} permanent
}
