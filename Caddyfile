{
    email admin@physrisk.com
}

physrisk.com {
    # Strip /api prefix so FastAPI receives /docs and /openapi.json as expected
    handle /api/docs* {
        uri strip_prefix /api
        reverse_proxy api:8081
    }
    handle /api/openapi.json {
        uri strip_prefix /api
        reverse_proxy api:8081
    }

    handle /api/tiles/* {
        rate_limit {
            zone tiles {
                key {remote_host}
                events 600
                window 1m
            }
        }
        reverse_proxy api:8081
    }

    handle /auth/* {
        reverse_proxy api:8081
    }

    handle /api/* {
        rate_limit {
            zone api {
                key {remote_host}
                events 60
                window 1m
            }
        }
        reverse_proxy api:8081
    }

    # FastAPI serves docs and openapi schema without the /api prefix
    handle /docs* {
        reverse_proxy api:8081
    }
    handle /openapi.json {
        reverse_proxy api:8081
    }

    # Route everything else to the UI container
    # On 404, fall back to index.html for SPA client-side routing
    handle {
        reverse_proxy ui:8080 {
            @notfound status 404
            handle_response @notfound {
                rewrite * /index.html
                reverse_proxy ui:8080
            }
        }
    }
}

# Redirect www to non-www
www.physrisk.com {
    redir https://physrisk.com{uri} permanent
}
