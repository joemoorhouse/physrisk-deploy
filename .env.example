# Copy this file to .env and fill in values before deploying.
# These variables are passed to the physrisk-api container.

# Example: S3/object-store credentials if the API reads climate data from cloud storage
OSC_S3_BUCKET=os-climate-physical-risk
# OSC_S3_ACCESS_KEY=your-access-key
# OSC_S3_SECRET_KEY=your-secret-key
# OSC_S3_ENDPOINT=https://s3.amazonaws.com
